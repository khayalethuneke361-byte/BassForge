<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NeoLabel">
        <attr name="neoRole" format="enum">
            <enum name="text" value="0" />
            <enum name="dim" value="1" />
            <enum name="accent" value="2" />
        </attr>
    </declare-styleable>
    <declare-styleable name="NeoCard">
        <attr name="neoStyle" format="enum">
            <enum name="raised" value="0" />
            <enum name="inset" value="1" />
            <enum name="glass" value="2" />
            <enum name="flat" value="3" />
        </attr>
    </declare-styleable>
</resources>
