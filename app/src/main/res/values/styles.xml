<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BassForge" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/neo_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
